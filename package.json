{
  "name": "swafto",
  "private": true,
  "version": "0.1.0",
  "description": "SWAFTO Retail Desk V1 — offline-first daily cash-and-credit closing for small Indian retail shops",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --dir packages",
    "test:vectors:node": "node tools/run-vectors.mjs --runtime=node --out=reports/vectors-node.json",
    "test:vectors:hermes": "node tools/run-vectors-hermes.mjs --out=reports/vectors-hermes.json",
    "check:divergence": "npm run test:vectors:node && npm run test:vectors:hermes && npm run test:vectors:diff",
    "test:vectors:diff": "node tools/diff-vectors.mjs reports/vectors-node.json reports/vectors-hermes.json",
    "check:governance": "node tools/check-governance.mjs",
    "check:benchmarks": "node tools/check-benchmarks-lock.mjs",
    "vectors:author": "node --experimental-strip-types tools/author-vectors.ts",
    "db:emit": "node --experimental-strip-types tools/emit-sql.mjs",
    "check:prose": "node tools/check-prose.mjs",
    "check:sms": "node tools/check-sms-templates.mjs",
    "check:all": "npm run check:governance && npm run check:benchmarks && npm run check:prose && npm run check:sms && npm run check:sms:segments && npm run check:tooling && npm run check:generated && npm run check:font && npm run check:money && npm run check:shadow && npm run check:plan && npm run check:tasks && npm run check:design && npm run check:layout && npm run check:client-logs && npm run check:naming && npm run check:push && npm run check:licences && npm run check:crossdoc && npm run check:divergence && npm run typecheck && npm run check:secrets && npm run check:traceability && npm run check:registry && npm run check:findings && npm run check:verifiers",
    "check:sms:segments": "node tools/check-sms-segments.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "detection-rate": "node tools/detection-rate.mjs",
    "rejects:author": "node --experimental-strip-types tools/author-rejects.ts",
    "check:generated": "node tools/check-generated.mjs",
    "check:font": "node tools/check-font-coverage.mjs",
    "check:money": "node tools/check-money-lint.mjs",
    "check:shadow": "node tools/check-shadow-copies.mjs",
    "plan": "node tools/gen-plan.mjs",
    "check:plan": "node tools/gen-plan.mjs --check",
    "tasks": "node tools/gen-tasks.mjs",
    "check:tasks": "node tools/gen-tasks.mjs --check",
    "design": "node tools/gen-design.mjs",
    "sheet": "node tools/gen-contact-sheet.mjs",
    "shots": "node tools/shoot-contact-sheet.mjs",
    "check:layout": "node --experimental-strip-types tools/check-layout.mjs",
    "check:client-logs": "node tools/check-client-logs.mjs",
    "check:naming": "node tools/check-export-naming.mjs",
    "check:push": "node tools/check-push-payload.mjs",
    "gen:datasafety": "node --experimental-strip-types tools/gen-data-safety.mjs",
    "check:licences": "node tools/check-licences.mjs",
    "check:design": "node tools/gen-design.mjs --check",
    "check:crossdoc": "node tools/check-crossdoc.mjs",
    "pin": "node tools/pin-injections.mjs",
    "design:prove": "node tools/gen-design.mjs --prove",
    "check:shadow:prove": "node tools/check-shadow-copies.mjs --prove",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='packages/formula-engine/src/**' --coverage.include='apps/api/src/**' --coverage.reporter=text --coverage.reporter=json-summary",
    "coverage:engine": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='packages/formula-engine/src/**' --coverage.reporter=text-summary",
    "coverage:api": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='apps/api/src/**' --coverage.reporter=text-summary",
    "check:verifiers": "node tools/check-verifiers.mjs",
    "prove:verifiers": "node tools/check-verifiers.mjs --prove",
    "responds:verifiers": "node tools/check-verifiers.mjs --responds",
    "check:traceability": "node tools/check-traceability.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "mutation": "stryker run",
    "mutation:money": "node tools/check-money-mutants.mjs",
    "mutation:money:prove": "node tools/check-money-mutants.mjs --prove",
    "check:findings": "node tools/check-findings.mjs",
    "check:registry": "node tools/check-registry.mjs"
  },
  "devDependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fastify": "^5.12.5",
    "hermes-engine": "^0.11.0",
    "hermes-engine-cli": "^0.12.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.81.4",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
