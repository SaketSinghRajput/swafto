{
  "name": "swafto",
  "private": true,
  "version": "0.1.0",
  "description": "SWAFTO Retail Desk V1 — offline-first daily cash-and-credit closing for small Indian retail shops",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --dir packages",
    "test:vectors:node": "node tools/run-vectors.mjs --runtime=node --out=.vectors-node.json",
    "test:vectors:hermes": "node tools/run-vectors-hermes.mjs --out=.vectors-hermes.json",
    "test:vectors:diff": "node tools/diff-vectors.mjs .vectors-node.json .vectors-hermes.json",
    "check:governance": "node tools/check-governance.mjs",
    "check:benchmarks": "node tools/check-benchmarks-lock.mjs",
    "vectors:author": "node --experimental-strip-types tools/author-vectors.ts",
    "db:emit": "node --experimental-strip-types tools/emit-sql.mjs",
    "check:prose": "node tools/check-prose.mjs",
    "check:sms": "node tools/check-sms-templates.mjs",
    "check:all": "npm run check:governance && npm run check:benchmarks && npm run check:prose && npm run check:sms && npm run check:sms:segments && npm run check:tooling && npm run check:generated && npm run check:font && npm run check:money && npm run typecheck && npm run check:secrets && npm run check:traceability && npm run check:registry && npm run check:findings && npm run check:verifiers",
    "check:sms:segments": "node tools/check-sms-segments.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "detection-rate": "node tools/detection-rate.mjs",
    "rejects:author": "node --experimental-strip-types tools/author-rejects.ts",
    "check:generated": "node tools/check-generated.mjs",
    "check:font": "node tools/check-font-coverage.mjs",
    "check:money": "node tools/check-money-lint.mjs",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='packages/formula-engine/src/**' --coverage.include='apps/api/src/**' --coverage.reporter=text --coverage.reporter=json-summary",
    "check:verifiers": "node tools/check-verifiers.mjs",
    "prove:verifiers": "node tools/check-verifiers.mjs --prove",
    "check:traceability": "node tools/check-traceability.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "mutation": "stryker run",
    "mutation:money": "node tools/check-money-mutants.mjs",
    "mutation:money:prove": "node tools/check-money-mutants.mjs --prove",
    "check:findings": "node tools/check-findings.mjs",
    "check:registry": "node tools/check-registry.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "hermes-engine": "^0.11.0",
    "hermes-engine-cli": "^0.12.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
