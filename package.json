{
  "name": "swafto",
  "private": true,
  "version": "0.1.0",
  "description": "SWAFTO Retail Desk V1 — offline-first daily cash-and-credit closing for small Indian retail shops",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test:unit": "vitest run --dir packages",
    "test:vectors": "node --experimental-strip-types tools/run-vectors.ts",
    "test:vectors:node": "node tools/run-vectors.mjs --runtime=node --out=.vectors-node.json",
    "test:vectors:hermes": "node tools/run-vectors-hermes.mjs --out=.vectors-hermes.json",
    "test:vectors:diff": "node tools/diff-vectors.mjs .vectors-node.json .vectors-hermes.json",
    "check:traceability": "node tools/check-traceability.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:i18n": "node tools/check-i18n.mjs",
    "check:governance": "node tools/check-governance.mjs",
    "check:benchmarks": "node tools/check-benchmarks-lock.mjs",
    "vectors:author": "node --experimental-strip-types tools/author-vectors.ts",
    "db:emit": "node --experimental-strip-types tools/emit-sql.mjs",
    "check:prose": "node tools/check-prose.mjs",
    "check:sms": "node tools/check-sms-templates.mjs",
    "check:all": "npm run check:governance && npm run check:benchmarks && npm run check:prose && npm run check:sms && npm run check:sms:segments && npm run check:tooling && npm run check:generated",
    "check:sms:segments": "node tools/check-sms-segments.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "detection-rate": "node tools/detection-rate.mjs",
    "rejects:author": "node --experimental-strip-types tools/author-rejects.ts",
    "check:generated": "node tools/check-generated.mjs"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "hermes-engine": "^0.11.0",
    "hermes-engine-cli": "^0.12.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
