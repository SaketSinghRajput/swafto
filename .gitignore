node_modules/
dist/
build/
coverage/
*.log
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo
.turbo/
android/app/build/
ios/Pods/
*.keystore
!debug.keystore

# Android build state. `build/` above catches the output directories; these are
# the three it does not.
#
# local.properties carries an absolute SDK path for ONE machine
# (C:/Users/user/swafto-toolchain/sdk here). Committed, it breaks the build for
# everyone else and publishes the layout of this one. Every Android project
# ignores it, for that reason.
#
# .cxx/ is the NDK's intermediate output and runs to hundreds of megabytes.
.gradle/
local.properties
.cxx/
.terraform/
*.tfstate
*.tfstate.*
.hermes-bundle.js
nul
.detection-tmp.json

# Stryker sandboxes: full copies of the repo. Left behind, vitest discovers them and
# runs every test twice, and the mutation harness reads doubled counts.
.stryker-tmp/

# Generated run output. reports/mutation/ IS tracked - these are not.
reports/vectors-node.json
reports/vectors-hermes.json
reports/sms-segments.json

# Private keys never belong in a repository, ignored or not - the EC2 key
# for the Mumbai instance was found sitting in AWS/ on 2026-10-11 and moved
# to ../swafto-keys/. These patterns are belt and braces: check:secrets
# walks the FILESYSTEM and does not read this file, so it will still fail
# on a key left in the tree. That is deliberate - a key in the working
# directory is one zip, rsync or `git add -f` away from being published.
*.pem
*.key
*.p12
*.jks
AWS/

# Local agent/plugin state - not this product. These mutate constantly (they
# blocked a history rewrite on 2026-10-11) and one of them is a SQLite WAL,
# which is a binary that can carry whatever the plugin last touched.
.claude/
.claude-flow/

# Device recordings and raw captures. They can show the tester's own phone
# (home screen, notifications), so they stay on the machine; the reviews
# written from them are committed under docs/device-reviews/.
artifacts/device-tests/

# Dev-server session signing key (tools/dev-server.mjs). Never commit a key.
tools/.dev/
